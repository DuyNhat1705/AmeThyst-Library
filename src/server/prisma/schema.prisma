generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model books {
  book_id          String                 @id @db.VarChar(20)
  title            String?
  original_title   String?
  description      String?
  num_pages        Int?
  publisher        String?
  publication_date DateTime?              @db.Date
  isbn             String?                @db.VarChar(50)
  rating           Float?                 @db.Real
  series           String?
  author           String[]
  language_code    String?                @db.VarChar(50)
  book_format      String?                @db.VarChar(50)
  genres           String[]
  filter_genres    String[]
  image_url        String?
  price            Float?                 @db.Real
  embedding        Unsupported("vector")?
  borrow_book      borrow_book[]
  library          library[]
  search_history   search_history[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model borrow_book {
  borrow_id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String        @db.Uuid
  book_id      String        @db.VarChar(20)
  branch_id    Int
  reserve_date DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  borrow_date  DateTime?     @db.Date
  due_date     DateTime?     @db.Date
  pin          String?       @db.VarChar(10)
  expired_at   DateTime?     @db.Timestamp(6)
  status       String        @default("expired") @db.VarChar(20)
  books        books         @relation(fields: [book_id], references: [book_id], onUpdate: NoAction, map: "fk_borrowbook_book")
  branches     branches      @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_borrowbook_branch")
  users        users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_borrowbook_user")
  damage       damage[]
  return_book  return_book[]
}

model branches {
  branch_id    Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  name_short   String         @unique @db.VarChar(10)
  address      String
  contact      String         @db.VarChar(50)
  borrow_book  borrow_book[]
  facility     facility[]
  library      library[]
  reserve_room reserve_room[]
  return_book  return_book[]
}

model damage {
  damage_id   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  borrow_id   String      @db.Uuid
  acm_date    DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  lose        Boolean?    @default(false)
  torn        Boolean?    @default(false)
  borrow_book borrow_book @relation(fields: [borrow_id], references: [borrow_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_damage_borrowbook")
  loan        loan[]
}

model facility {
  room_id    Int        @id
  branch_id  Int
  available  Boolean?   @default(true)
  branches   branches   @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_facility_branch")
  study_room study_room @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_facility_studyroom")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model library {
  book_id            String   @db.VarChar(20)
  branch_id          Int
  quantity           Int      @default(0)
  available_quantity Int      @default(0)
  shelf              String?  @db.VarChar(20)
  books              books    @relation(fields: [book_id], references: [book_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_library_book")
  branches           branches @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_library_branch")

  @@id([book_id, branch_id])
}

model loan {
  loan_id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  return_id   String?      @db.Uuid
  damage_id   String?      @db.Uuid
  user_id     String       @db.Uuid
  recog_date  DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  loss        Boolean?     @default(false)
  torn        Boolean?     @default(false)
  overdue     Boolean?     @default(false)
  recog_loan  Decimal?     @default(0.00) @db.Decimal(10, 2)
  paid        Boolean?     @default(false)
  damage      damage?      @relation(fields: [damage_id], references: [damage_id], onUpdate: NoAction, map: "fk_loan_damge")
  return_room return_room? @relation(fields: [return_id], references: [return_id], onUpdate: NoAction, map: "fk_loan_return")
  users       users        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_loan_user")
}

model otp_store {
  email      String   @id @db.VarChar(255)
  otp        String   @db.VarChar(10)
  expired_at DateTime @db.Timestamp(6)
  verified   Boolean? @default(false)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pending_users {
  token         String   @id @db.Uuid
  email         String   @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  username      String   @db.VarChar(100)
  role          String   @default("user") @db.VarChar(20)
  expired_at    DateTime @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reserve_room {
  reserve_id  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String        @db.Uuid
  room_id     Int
  branch_id   Int
  start_time  DateTime      @default(now()) @db.Timestamp(6)
  end_time    DateTime      @db.Timestamp(6)
  branches    branches      @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reserve_branch")
  study_room  study_room    @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reserve_room")
  users       users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reserve_user")
  return_room return_room[]
}

model return_book {
  return_id   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  borrow_id   String      @db.Uuid
  branch_id   Int
  return_date DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  borrow_book borrow_book @relation(fields: [borrow_id], references: [borrow_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_returnbook_borrowbook")
  branches    branches    @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_returnbook_branch")
}

model return_room {
  return_id    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reserve_id   String       @db.Uuid
  return_time  DateTime     @default(now()) @db.Timestamp(6)
  loan         loan[]
  reserve_room reserve_room @relation(fields: [reserve_id], references: [reserve_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_returnroom_reserve")
}

model search_history {
  search_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  book_clicked   String?  @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  search_content String?
  search_mode    String?  @default("standard") @db.VarChar(20)
  filters        Json?
  books          books?   @relation(fields: [book_clicked], references: [book_id], onUpdate: NoAction, map: "fk_search_book")
  users          users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_search_user")
}

model study_room {
  room_id         Int            @id @default(autoincrement())
  room_name       String         @unique @db.VarChar(100)
  tv_available    Boolean?       @default(true)
  board_available Boolean?       @default(true)
  capacity        Int
  description     String?
  facility        facility?
  reserve_room    reserve_room[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String           @unique @db.VarChar(255)
  password_hash  String           @db.VarChar(255)
  username       String           @unique @db.VarChar(100)
  phone_number   String?          @db.VarChar(20)
  avatar         String?          @db.VarChar(500)
  role           String           @default("user") @db.VarChar(20)
  borrow_num     Int              @default(0)
  borrow_book    borrow_book[]
  loan           loan[]
  reserve_room   reserve_room[]
  search_history search_history[]
}
